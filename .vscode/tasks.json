{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "GroundTruth: start everything locally",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/start-groundtruth.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "GroundTruth: local model",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/start-local-model.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "GroundTruth: controlled local changes",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/start-local-workspace.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "GroundTruth: website",
      "type": "shell",
      "command": "corepack",
      "args": [
        "pnpm",
        "dev"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "GroundTruth: typecheck",
      "type": "shell",
      "command": "corepack",
      "args": [
        "pnpm",
        "typecheck"
      ],
      "problemMatcher": []
    }
  ]
}
