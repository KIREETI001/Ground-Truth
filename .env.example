# Local development template. Copy to ignored .dev.vars; never commit real values.
# Hosted deployments use secure Sites environment configuration, not this file.
# DB is the declared D1 binding and is not configured with a string here.

MODEL_CALLS_ENABLED="false"
MODEL_API_KEY=""
# Adapter pins these values. A blank key and disabled calls perform no live inference.
MODEL_BASE_URL="https://api.meta.ai/v1"
MODEL_ID="muse-spark-1.3"

PILOT_ID="groundtruth-local"
PILOT_MAX_MEMBERS="5"
PILOT_ENROLLMENT_ENABLED="false"
PILOT_ENROLLMENT_CODE=""

# JSON mapping of observed Site IDs to owner/tutor roles. Hosted IDs differ by Site.
# Portable loopback development only: {"local_seedy":"owner"}
STAFF_USER_ROLES='{}'
